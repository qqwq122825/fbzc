# 依赖与虚拟环境
.venv/
__pycache__/
*.pyc
.DS_Store

# 运行时数据（含 cookies / 账号 / 抓包，绝不入库）
data/
!data/*.sample
!data/graphql_docs.json

# 抓包与报告产物
apk/work/
apk/report/
*.flow
*.png
*.log

# 本地配置
data/email.json
data/proxies.txt
data/phones.txt

# 私密运行产物：即使复制进仓库也不得提交
*_PRIVATE.*
*PRIVATE*.json
*PRIVATE*.txt
*UNSAFE*.json
*SESSION*.json
*COOKIE*.json
*OTP*.json
account-attempt-*/
mailbox-probe-*/
proxy-egress-*/
